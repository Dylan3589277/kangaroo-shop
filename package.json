    "antd": "^6.3.6",
    "axios": "^1.15.2",
    "bcryptjs": "^3.0.3",
    "dayjs": "^1.11.20",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "next": "14.2.35",
    "next-auth": "4.24.11",
    "next-intl": "^4.9.1",
    "nodemailer": "^8.0.5",
    "prisma": "^5.22.0",
    "react": "^18",
    "react-dom": "^18",
    "stripe": "^22.0.1"
  },
  "devDependencies": {
