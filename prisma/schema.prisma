// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_DATABASE_URL")
}

// ============================================
// 商品表
// ============================================
model Product {
  id            String   @id @default(cuid())
  title         String   @map("title")
  titleEn       String?  @map("title_en")
  price         Int                // JPY，单位分（避免浮点）
  originalPrice Int?     @map("original_price")
  currency      String   @default("JPY")
  images        Json      @default("[]")           // JSON array stored as MySQL JSON
  category      String   @default("brainrot")
  source        String   @default("own")
  sourceUrl     String?  @map("source_url")
  rating        Float    @default(0)
  reviews       Int      @default(0)
  inStock       Boolean  @default(true) @map("in_stock")
  stock         Int      @default(0)
  description   String?
  weight        Int      @default(200)  // g，运费计算用
  isActive      Boolean  @default(true) @map("is_active")  // 软删除
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  orderItems OrderItem[]

  @@map("products")
}

// ============================================
// 订单主表
// ============================================
model Order {
  id            String   @id @default(cuid())
  orderNumber   String   @unique @map("order_number")  // KS20260417001

  // 支付信息
  paymentMethod   String   @map("payment_method")   // stripe / paypal
  paymentStatus   String   @default("pending") @map("payment_status")  // pending / paid / failed / cancelled / refunded
  paypalOrderId   String?  @map("paypal_order_id")
  stripePaymentIntentId String? @map("stripe_payment_intent_id")

  // 金额（JPY，单位分）
  subtotal     Int      @map("subtotal")
  shippingFee  Int      @default(0) @map("shipping_fee")
  total        Int      @map("total")

  // 配送
  courier      String   @default("yamato")  // yamato / sagawa / japanpost / seino

  // 收货地址
  shippingName       String?  @map("shipping_name")
  shippingPostal     String?  @map("shipping_postal")
  shippingPrefecture String?  @map("shipping_prefecture")
  shippingCity       String?  @map("shipping_city")
  shippingAddress1   String?  @map("shipping_address1")
  shippingAddress2   String?  @map("shipping_address2")
  shippingPhone      String?  @map("shipping_phone")
  shippingEmail      String?  @map("shipping_email")

  // 管理员备注
  adminNote    String?  @map("admin_note")

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  items   OrderItem[]
  history OrderStatusHistory[]

  @@index([paymentStatus])
  @@index([createdAt])
  @@index([shippingEmail])
  @@map("orders")
}

// ============================================
// 订单明细
// ============================================
model OrderItem {
  id            String   @id @default(cuid())
  orderId       String   @map("order_id")
  productId     String?  @map("product_id")
  productTitle  String   @map("product_title")
  productImage  String?  @map("product_image")
  price         Int                 // 购买时单价（JPY，分）
  quantity      Int
  weight        Int      @default(200)  // g

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// ============================================
// 订单状态变更历史
// ============================================
model OrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  fromStatus String? @map("from_status")
  toStatus   String  @map("to_status")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_status_history")
}

// ============================================
// 管理员账户
// ============================================
model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admins")
}
