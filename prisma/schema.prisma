// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// 商品表
// ============================================
model Product {
  id            String   @id @default(cuid())
  title         String   @map("title")
  titleEn       String?  @map("title_en")
  price         Int                // JPY，单位分（避免浮点）
  originalPrice Int?     @map("original_price")
  currency      String   @default("JPY")
  images        Json      @default("[]")           // JSON array stored as MySQL JSON
  category      String   @default("brainrot")
  source        String   @default("own")
  sourceUrl     String?  @map("source_url")
  rating        Float    @default(0)
  reviews       Int      @default(0)
  inStock       Boolean  @default(true) @map("in_stock")
  stock         Int      @default(0)
  description   String?
  weight        Int      @default(200)  // g，运费计算用
  isActive      Boolean  @default(true) @map("is_active")  // 软删除
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  orderItems  OrderItem[]
  reviewItems  Review[]

  @@map("products")
}

// ============================================
// 订单主表
// ============================================
model Order {
  id            String   @id @default(cuid())
  orderNumber   String   @unique @map("order_number")  // KS20260417001

  // 支付信息
  paymentMethod   String   @map("payment_method")   // stripe / paypal
  paymentStatus   String   @default("pending") @map("payment_status")  // pending / paid / failed / cancelled / refunded
  paypalOrderId   String?  @map("paypal_order_id")
  stripePaymentIntentId String? @map("stripe_payment_intent_id")

  // 金额（JPY，单位分）
  subtotal     Int      @map("subtotal")
  shippingFee  Int      @default(0) @map("shipping_fee")
  total        Int      @map("total")

  // 配送
  courier      String   @default("yamato")  // yamato / sagawa / japanpost / seino

  // 收货地址
  shippingName       String?  @map("shipping_name")
  shippingPostal     String?  @map("shipping_postal")
  shippingPrefecture String?  @map("shipping_prefecture")
  shippingCity       String?  @map("shipping_city")
  shippingAddress1   String?  @map("shipping_address1")
  shippingAddress2   String?  @map("shipping_address2")
  shippingPhone      String?  @map("shipping_phone")
  shippingEmail      String?  @map("shipping_email")

  // 管理员备注
  adminNote    String?  @map("admin_note")

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  items   OrderItem[]
  history OrderStatusHistory[]

  @@index([paymentStatus])
  @@index([createdAt])
  @@index([shippingEmail])
  @@map("orders")
}

// ============================================
// 订单明细
// ============================================
model OrderItem {
  id            String   @id @default(cuid())
  orderId       String   @map("order_id")
  productId     String?  @map("product_id")
  productTitle  String   @map("product_title")
  productImage  String?  @map("product_image")
  price         Int                 // 购买时单价（JPY，分）
  quantity      Int
  weight        Int      @default(200)  // g

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// ============================================
// 订单状态变更历史
// ============================================
model OrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  fromStatus String? @map("from_status")
  toStatus   String  @map("to_status")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_status_history")
}

// ============================================
// 管理员账户
// ============================================
model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admins")
}

// ============================================
// 经营仪表盘告警
// ============================================
model DashboardAlert {
  id             String    @id @default(cuid())
  metricId        String    @map("metric_id")
  metricName     String    @map("metric_name")
  module         String    // hr | finance | supply_chain | operation | influencer
  status         String    // green | yellow | red
  threshold      Float
  currentValue   Float     @map("current_value")
  assignee       String?
  deadline       DateTime?
  handlingResult String?   @map("handling_result")
  handler        String?
  resolvedAt     DateTime? @map("resolved_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("dashboard_alerts")
}

// ============================================
// 优惠券/促销活动
// ============================================
model Promotion {
  id                  String    @id @default(cuid())
  code                String    @unique @map("code")              // 优惠券码
  name                String    @map("name")                      // 活动名称
  description         String?   @map("description")               // 描述

  // 优惠类型与值
  type                String    @default("percentage_discount")   // percentage_discount | fixed_discount | free_shipping
  value               Int       @default(0)                       // 优惠值（百分比时为1-100，固定金额时为分）
  maxDiscountAmount   Int?      @map("max_discount_amount")       // 最大折扣金额上限（分）

  // 使用条件
  minOrderAmount      Int       @default(0) @map("min_order_amount")   // 最低订单金额（分）
  usageLimit          Int?      @map("usage_limit")                // 总使用次数限制
  usedCount           Int       @default(0) @map("used_count")     // 已使用次数
  perUserLimit        Int       @default(1) @map("per_user_limit")  // 每人限用次数

  // 适用范围的商品/分类
  applicableProducts  Json      @default("[]") @map("applicable_products")   // 适用商品ID数组，空数组=全部适用
  applicableCategories Json      @default("[]") @map("applicable_categories") // 适用分类数组

  // 时间
  startDate           DateTime  @map("start_date")
  endDate             DateTime  @map("end_date")

  // 状态
  isActive            Boolean   @default(true) @map("is_active")
  isPublic            Boolean   @default(true) @map("is_public")    // 是否公开给用户
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([code])
  @@index([isActive])
  @@index([endDate])
  @@map("promotions")
}

// ============================================
// 商品评价
// ============================================
model Review {
  id         String   @id @default(cuid())
  productId  String   @map("product_id")
  authorName String   @map("author_name")
  rating     Int                // 1-5
  title      String?
  content    String?
  isApproved Boolean @default(false) @map("is_approved")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isApproved])
  @@map("reviews")
}
