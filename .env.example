# ============================================
# 袋鼠君电商站 — 环境变量模板
# 复制此文件为 .env.local 并填写实际值
# ============================================

# ---------- 数据库 ----------
# Vercel MySQL 连接字符串
# 格式: mysql://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql://username:password@host:3306/database

# ---------- Stripe（海外信用卡支付）----------
# 测试环境用 pk_test_xxx，生产环境用 pk_live_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
# Stripe Webhook 签名密钥（stripe listen --forward-to localhost:3000/api/stripe/webhook 获取）
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ---------- PayPal ----------
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# ---------- Rakuten API（可选，商品数据抓取） ----------
RAKUTEN_APP_KEY=your_rakuten_app_key
RAKUTEN_AFFILIATE_ID=your_affiliate_id

# ---------- GeoIP（IP语言检测，可选） ----------
NEXT_PUBLIC_GEOIP_URL=/api/geoip

# ---------- App ----------
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# ---------- NextAuth（管理员认证） ----------
# 生成随机字符串: openssl rand -base64 32
NEXTAUTH_SECRET=your_random_secret_here
# 开发用 http://localhost:3000，生产用实际域名
NEXTAUTH_URL=http://localhost:3000

# ---------- 管理员账号 ----------
# 生产环境务必使用强密码！
ADMIN_EMAIL=admin@your-domain.com
# bcrypt 哈希后的密码（可选，明文也可用但建议迁移）
# 生成哈希: node -e "const b=require('bcryptjs'); b.hash('your-password', 10).then(r=>console.log(r))"
ADMIN_PASSWORD=your_plain_text_password

# ---------- 邮件通知（SMTP） ----------
# Gmail SMTP 示例
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=袋鼠君 <your@gmail.com>

# 阿里云 SMTP 示例
# SMTP_HOST=smtp.aliyun.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your@domain.com
# SMTP_PASS=your_password
# SMTP_FROM=袋鼠君 <your@domain.com>
